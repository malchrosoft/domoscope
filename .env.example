# Copy to .env and adjust if needed.
# Domoscope reads environment variables directly; a .env loader is not required.

# SQLite database path (relative paths are resolved from the project root)
DOMOSCOPE_DB=data/domoscope.db

# Optional: force the subnet to scan, e.g. 192.168.0.0/24
# DOMOSCOPE_SUBNET=192.168.0.0/24

# Web server
DOMOSCOPE_HOST=127.0.0.1
DOMOSCOPE_PORT=8765

# Set to 1 to query api.macvendors.com for unknown OUIs (off by default: no cloud dependency)
DOMOSCOPE_ONLINE_LOOKUP=0

# Tuya protocol version used by default for new devices (3.1, 3.2, 3.3, 3.4 or 3.5)
DOMOSCOPE_TUYA_VERSION=3.3

# Secret used to encrypt local keys in SQLite. If unset, a key is generated in data/secret.key.
# DOMOSCOPE_SECRET_KEY=
